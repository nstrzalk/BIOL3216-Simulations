/* Pure V1 heat model. Whole-body W; dry terms positive OUT, S positive stored. */
const HeatModel = (() => {
 const constants=Object.freeze({area:1.8,skin:33,clo:0.5,rcl:0.0775,fcl:1.075,emissivity:0.95,radiationArea:0.73,sigma:5.670374419e-8,lewis:16.5,permeability:0.45,mass:70});
 const activities=Object.freeze({rest:115,light:230,moderate:400,heavy:600});
 const saturation=t=>0.6108*Math.exp(17.27*t/(t+237.3));
 function dryExchange(temperature,wind,p=constants){
  const hc=Math.max(3,8.6*Math.pow(wind,0.53));
  const flux=tcl=>({convection:p.area*p.fcl*hc*(tcl-temperature),radiation:p.area*p.fcl*p.radiationArea*p.emissivity*p.sigma*((tcl+273.15)**4-(temperature+273.15)**4)});
  let lo=Math.min(temperature,p.skin),hi=Math.max(temperature,p.skin);
  for(let i=0;i<70;i++){const mid=(lo+hi)/2,q=flux(mid),residual=p.area*(p.skin-mid)/p.rcl-q.convection-q.radiation;if(residual>0)lo=mid;else hi=mid;}
  const clothing=(lo+hi)/2;return {...flux(clothing),conduction:0,clothing,hc};
 }
 function evaporation(temperature,humidity,hc,p=constants){
  const gradient=saturation(p.skin)-humidity/100*saturation(temperature);
  const resistance=p.rcl/(p.permeability*p.lewis)+1/(p.fcl*p.lewis*hc);
  return {gradient,resistance,maximum:Math.max(0,p.area*gradient/resistance),condensation:gradient < -1e-10};
 }
 function calculate({temperature,humidity,wind,activity}){
  if(!Number.isFinite(temperature)||temperature<5||temperature>45||!Number.isFinite(humidity)||humidity<10||humidity>100||!Number.isFinite(wind)||wind<0||wind>4||!Object.hasOwn(activities,activity))throw new RangeError('Inputs outside V1 domain');
  const dry=dryExchange(temperature,wind),vapour=evaporation(temperature,humidity,dry.hc),metabolic=activities[activity];
  const load=metabolic-dry.convection-dry.radiation-dry.conduction,required=Math.max(0,load),actual=Math.min(required,vapour.maximum),storage=load-actual;
  return {...dry,...vapour,metabolic,load,required,actual,storage,state:storage>1e-8?'gain':storage < -1e-8?'loss':'balance'};
 }
 return Object.freeze({constants,activities,saturation,dryExchange,evaporation,calculate});
})();
