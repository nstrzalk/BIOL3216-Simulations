  window.addEventListener('pagehide',()=>lifecycle.abort(),{once:true});
  const register=tool=>Promise.resolve(document.modelContext.registerTool(tool,{signal:lifecycle.signal})).catch(error=>console.warn('Optional WebMCP registration unavailable:',error.message));
  const respond=value=>({content:[{type:'text',text:JSON.stringify(value)}]});
  try{
   register({name:'read_heat_balance',description:'Read the current four teaching-model inputs and whole-body heat rates in W. Dry terms are positive outward; positive storage means heat gain.',inputSchema:{type:'object',properties:{},additionalProperties:false},annotations:{readOnlyHint:true},execute:async()=>respond({inputs:read(),outputs:lastResult})});
   register({name:'set_heat_balance_conditions',description:'Set any of the same four visible controls. This is a teaching model, not a clinical core-temperature prediction.',inputSchema:{type:'object',properties:{temperature:{type:'integer',minimum:5,maximum:45},humidity:{type:'integer',minimum:10,maximum:100},wind:{type:'number',minimum:0,maximum:4,multipleOf:0.1},activity:{type:'string',enum:['rest','light','moderate','heavy']}},additionalProperties:false},execute:async p=>respond(setConditions(p))});
  }catch(error){console.warn('Optional WebMCP registration unavailable:',error.message);}
 }
})();

